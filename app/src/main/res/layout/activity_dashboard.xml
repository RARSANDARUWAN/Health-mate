<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121C14">

    <!-- main scroll area -->
    <ScrollView
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- top bar -->
            <LinearLayout
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:contentDescription="App Logo"
                    android:src="@drawable/app_logo"
                    android:layout_marginEnd="10dp"
                    android:id="@+id/ivAppLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp" />

                <TextView
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:text="Health Tracker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Profile"
                    android:src="@drawable/baseline_person_pin_24"
                    android:id="@+id/btnTopProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp" />

                <ImageView
                    android:contentDescription="Logout"
                    android:src="@drawable/baseline_logout_24"
                    android:id="@+id/btnLogout"
                    android:layout_width="24dp"
                    android:layout_height="24dp" />
            </LinearLayout>

            <!-- summary title header -->
            <LinearLayout
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:letterSpacing="0.05"
                        android:textColor="#8FA693"
                        android:textSize="11sp"
                        android:text="TODAY SUMMARY"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:text="Calm Health Metrics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="12dp"
                    android:background="#1E2E22"
                    android:textColor="#8CB89B"
                    android:textSize="12sp"
                    android:text="• Oct 28"
                    android:id="@+id/tvDateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- water card -->
            <LinearLayout
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#1A261D"
                android:layout_width="match_parent"
                android:layout_height="72dp">

                <ImageView
                    android:contentDescription="Water"
                    android:src="@drawable/baseline_water_drop_24"
                    android:padding="8dp"
                    android:background="#163138"
                    android:layout_marginEnd="16dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textColor="#8CB89B"
                        android:textSize="12sp"
                        android:text="Water Intake"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:text="0 ml "
                        android:id="@+id/tvWaterVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- steps card -->
            <LinearLayout
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#1A261D"
                android:layout_width="match_parent"
                android:layout_height="72dp">

                <ImageView
                    android:contentDescription="Steps"
                    android:src="@drawable/baseline_directions_run_24"
                    android:padding="8dp"
                    android:background="#183322"
                    android:layout_marginEnd="16dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textColor="#8CB89B"
                        android:textSize="12sp"
                        android:text="Steps Walked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:text="0 steps"
                        android:id="@+id/tvStepsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- calories card -->
            <LinearLayout
                android:layout_marginBottom="24dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#1A261D"
                android:layout_width="match_parent"
                android:layout_height="72dp">

                <ImageView
                    android:contentDescription="Calories"
                    android:src="@drawable/baseline_local_fire_department_24"
                    android:padding="8dp"
                    android:background="#382216"
                    android:layout_marginEnd="16dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textColor="#D4A373"
                        android:textSize="12sp"
                        android:text="Calories Burned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:text="0 kcal"
                        android:id="@+id/tvCaloriesVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- history chart box -->
            <LinearLayout
                android:padding="16dp"
                android:background="#1A261D"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textStyle="bold"
                        android:textColor="#8FA693"
                        android:textSize="12sp"
                        android:text="WEEKLY CALORIE HISTORY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:textStyle="bold"
                        android:textColor="#8CB89B"
                        android:textSize="12sp"
                        android:text="Avg: 0 kcal"
                        android:id="@+id/tvAvgCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- bars layout -->
                <LinearLayout
                    android:weightSum="7"
                    android:orientation="horizontal"
                    android:gravity="bottom|center"
                    android:layout_width="match_parent"
                    android:layout_height="140dp">

                    <!-- mon -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#8FA693"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#8CB89B"
                            android:id="@+id/barMon"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:layout_marginTop="6dp"
                            android:textColor="#8FA693"
                            android:textSize="11sp"
                            android:text="Mon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- tue -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#8FA693"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#8CB89B"
                            android:id="@+id/barTue"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:layout_marginTop="6dp"
                            android:textColor="#8FA693"
                            android:textSize="11sp"
                            android:text="Tue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- wed -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#8FA693"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#8CB89B"
                            android:id="@+id/barWed"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:layout_marginTop="6dp"
                            android:textColor="#8FA693"
                            android:textSize="11sp"
                            android:text="Wed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- thu -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#4CAF50"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#2E7D32"
                            android:id="@+id/barThu"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:textStyle="bold"
                            android:layout_marginTop="6dp"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:text="Thu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- fri -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#8FA693"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#8CB89B"
                            android:id="@+id/barFri"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:layout_marginTop="6dp"
                            android:textColor="#8FA693"
                            android:textSize="11sp"
                            android:text="Fri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- sat -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#8FA693"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#8CB89B"
                            android:id="@+id/barSat"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:layout_marginTop="6dp"
                            android:textColor="#8FA693"
                            android:textSize="11sp"
                            android:text="Sat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- sun -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="bottom|center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_marginBottom="4px"
                            android:textColor="#8FA693"
                            android:textSize="9sp"
                            android:text="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:background="#8CB89B"
                            android:id="@+id/barSun"
                            android:layout_width="16dp"
                            android:layout_height="20dp" />

                        <TextView
                            android:layout_marginTop="6dp"
                            android:textColor="#8FA693"
                            android:textSize="11sp"
                            android:text="Sun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- action buttons -->
            <Button
                android:layout_marginBottom="12dp"
                android:backgroundTint="#10B981"
                android:textColor="#121C14"
                android:textStyle="bold"
                android:textSize="15sp"
                android:text="Add New Record"
                android:id="@+id/btnAddRecord"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <LinearLayout
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#1E2E22"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:text="View History"
                    android:id="@+id/btnViewHistory"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1" />

                <Button
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E2E22"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:text="Share Summary"
                    android:id="@+id/btnShareSummary"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- bottom bar -->
    <LinearLayout
        android:paddingTop="8dp"
        android:weightSum="3"
        android:orientation="horizontal"
        android:background="#162218"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="60dp">

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:contentDescription="Home"
                android:src="@drawable/baseline_home_24"
                android:layout_width="22dp"
                android:layout_height="22dp" />
            <TextView
                android:textStyle="bold"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:text="Home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:contentDescription="History"
                android:src="@drawable/baseline_history_24"
                android:layout_width="22dp"
                android:layout_height="22dp" />
            <TextView
                android:textColor="#7A8C7E"
                android:textSize="11sp"
                android:text="History"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:contentDescription="Profile"
                android:src="@drawable/baseline_person_24"
                android:layout_width="22dp"
                android:layout_height="22dp" />
            <TextView
                android:textColor="#7A8C7E"
                android:textSize="11sp"
                android:text="Profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>