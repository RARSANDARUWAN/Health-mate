<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen: Register Screen (Create Account)
    Author: Student Assignment Clean Code Implementation
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:background="#121C14"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <LinearLayout
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_height="wrap_content"
        android:layout_width="match_parent">

        <!-- top logo -->
        <ImageView
            android:layout_marginBottom="24dp"
            android:layout_marginTop="32dp"
            android:contentDescription="App Logo"
            android:src="@drawable/app_logo"
            android:id="@+id/ivAppLogo"
            android:layout_height="80dp"
            android:layout_width="80dp" />

        <!-- form card block -->
        <LinearLayout
            android:padding="20dp"
            android:background="#1A261D"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_width="match_parent">

            <!-- header title -->
            <TextView
                android:layout_marginBottom="4dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="24sp"
                android:text="Create Account"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

            <!-- subtitle -->
            <TextView
                android:layout_marginBottom="24dp"
                android:textColor="#8FA693"
                android:textSize="13sp"
                android:text="Join our peaceful health community"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

            <!-- full name input -->
            <EditText
                android:layout_marginBottom="14dp"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:background="#243328"
                android:textColorHint="#7A8C7E"
                android:textColor="#FFFFFF"
                android:hint="Full Name"
                android:id="@+id/etFullName"
                android:layout_height="50dp"
                android:layout_width="match_parent" />

            <!-- age input -->
            <EditText
                android:layout_marginBottom="14dp"
                android:textSize="14sp"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:background="#243328"
                android:textColorHint="#7A8C7E"
                android:textColor="#FFFFFF"
                android:hint="Age"
                android:id="@+id/etAge"
                android:layout_height="50dp"
                android:layout_width="match_parent" />

            <!-- email input -->
            <EditText
                android:layout_marginBottom="14dp"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:background="#243328"
                android:textColorHint="#7A8C7E"
                android:textColor="#FFFFFF"
                android:hint="Email Address"
                android:id="@+id/etEmail"
                android:layout_height="50dp"
                android:layout_width="match_parent" />

            <!-- password input -->
            <EditText
                android:layout_marginBottom="24dp"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:background="#243328"
                android:textColorHint="#7A8C7E"
                android:textColor="#FFFFFF"
                android:hint="Password"
                android:id="@+id/etPassword"
                android:layout_height="50dp"
                android:layout_width="match_parent" />

            <!-- register button -->
            <Button
                android:layout_marginBottom="20dp"
                android:backgroundTint="#8CB89B"
                android:textColor="#121C14"
                android:textStyle="bold"
                android:textSize="15sp"
                android:text="Register"
                android:id="@+id/btnRegister"
                android:layout_height="52dp"
                android:layout_width="match_parent" />

            <!-- login navigation link -->
            <TextView
                android:padding="8dp"
                android:layout_gravity="center_horizontal"
                android:textSize="13sp"
                android:textColor="#8CB89B"
                android:text="Already have an account? Login here"
                android:id="@+id/tvLoginLink"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>