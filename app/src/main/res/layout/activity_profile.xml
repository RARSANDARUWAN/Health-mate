<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121C14">

    <!-- scrollable profile content -->
    <ScrollView
        android:scrollbarSize="6dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:fadeScrollbars="false"
        android:scrollbars="vertical"
        android:fillViewport="true"
        android:layout_above="@id/bottomNavBar"
        android:layout_height="match_parent"
        android:layout_width="match_parent">

        <LinearLayout
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_width="match_parent">

            <!-- top header -->
            <LinearLayout
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <ImageView
                    android:contentDescription="Back"
                    android:src="@drawable/baseline_arrow_back_24"
                    android:id="@+id/btnBack"
                    android:layout_height="24dp"
                    android:layout_width="24dp" />

                <TextView
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:text="My Profile"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_height="24dp"
                    android:layout_width="24dp" />
            </LinearLayout>

            <!-- avatar and user info card -->
            <LinearLayout
                android:layout_marginBottom="20dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#162218"
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <!-- avatar wrapper -->
                <RelativeLayout
                    android:layout_marginBottom="12dp"
                    android:layout_height="80dp"
                    android:layout_width="80dp">

                    <ImageView
                        android:contentDescription="Avatar"
                        android:src="@drawable/baseline_person_24"
                        android:padding="16dp"
                        android:layout_height="match_parent"
                        android:layout_width="match_parent" />

                    <!-- verified tick badge -->
                    <TextView
                        android:gravity="center"
                        android:textColor="#3B82F6"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:text="✓"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_height="20dp"
                        android:layout_width="20dp" />
                </RelativeLayout>

                <!-- user name -->
                <TextView
                    android:layout_marginBottom="4dp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:text="John Doe"
                    android:id="@+id/tvProfileName"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content" />

                <!-- user email -->
                <TextView
                    android:textColor="#8FA693"
                    android:textSize="13sp"
                    android:text="johndoe@email.com"
                    android:id="@+id/tvProfileEmail"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content" />
            </LinearLayout>

            <!-- info rows container -->
            <LinearLayout
                android:layout_marginBottom="24dp"
                android:padding="16dp"
                android:background="#1A261D"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <!-- age row -->
                <LinearLayout
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent">

                    <ImageView
                        android:contentDescription="Age"
                        android:src="@drawable/baseline_directions_run_24"
                        android:layout_marginEnd="12dp"
                        android:layout_height="20dp"
                        android:layout_width="20dp" />

                    <TextView
                        android:textColor="#8FA693"
                        android:textSize="14sp"
                        android:text="Age"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:text="24 years"
                        android:id="@+id/tvUserAge"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content" />
                </LinearLayout>

                <!-- joined date row -->
                <LinearLayout
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent">

                    <ImageView
                        android:contentDescription="Joined"
                        android:src="@drawable/baseline_calendar_today_24"
                        android:layout_marginEnd="12dp"
                        android:layout_height="20dp"
                        android:layout_width="20dp" />

                    <TextView
                        android:textColor="#8FA693"
                        android:textSize="14sp"
                        android:text="Joined Date"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:text="October 2026"
                        android:id="@+id/tvJoinedDate"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content" />
                </LinearLayout>

                <!-- logs count row -->
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent">

                    <ImageView
                        android:contentDescription="Logs"
                        android:src="@drawable/baseline_history_24"
                        android:layout_marginEnd="12dp"
                        android:layout_height="20dp"
                        android:layout_width="20dp" />

                    <TextView
                        android:textColor="#8FA693"
                        android:textSize="14sp"
                        android:text="Total Logs Created"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="15 Health Records Saved"
                        android:id="@+id/tvTotalLogs"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- edit profile button -->
            <Button
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1E2E22"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="Edit Profile"
                android:id="@+id/btnEditProfile"
                android:layout_height="48dp"
                android:layout_width="match_parent" />

            <!-- logout button -->
            <Button
                android:layout_marginBottom="16dp"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="Log Out"
                android:id="@+id/btnLogout"
                android:layout_height="48dp"
                android:layout_width="match_parent" />

            <!-- app version text -->
            <TextView
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:textColor="#7A8C7E"
                android:textSize="11sp"
                android:text="Health Tracker App v1.0"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- bottom navigation bar with profile active -->
    <LinearLayout
        android:paddingTop="8dp"
        android:weightSum="3"
        android:orientation="horizontal"
        android:background="#162218"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottomNavBar"
        android:layout_height="60dp"
        android:layout_width="match_parent">

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/navHome"
            android:layout_height="match_parent"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                android:contentDescription="Home"
                android:src="@drawable/baseline_home_24"
                android:layout_height="22dp"
                android:layout_width="22dp" />
            <TextView
                android:textColor="#7A8C7E"
                android:textSize="11sp"
                android:text="Home"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/navHistory"
            android:layout_height="match_parent"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                android:contentDescription="History"
                android:src="@drawable/baseline_history_24"
                android:layout_height="22dp"
                android:layout_width="22dp" />
            <TextView
                android:textColor="#7A8C7E"
                android:textSize="11sp"
                android:text="History"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_height="match_parent"
            android:layout_width="0dp"
            android:layout_weight="1">
            <ImageView
                android:contentDescription="Profile"
                android:src="@drawable/baseline_person_24"
                android:layout_height="22dp"
                android:layout_width="22dp" />
            <TextView
                android:textStyle="bold"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:text="Profile"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>